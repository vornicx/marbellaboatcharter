{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/yachts/:slug", "destination": "/api/yacht?slug=:slug" },
    { "source": "/destinations/:slug", "destination": "/api/content?type=destination&slug=:slug" },
    { "source": "/experiences/:slug", "destination": "/api/content?type=experience&slug=:slug" },
    { "source": "/services/:slug", "destination": "/api/content?type=service&slug=:slug" }
  ],
  "redirects": [
    { "source": "/motoryachts", "destination": "/fleet", "permanent": true },
    { "source": "/sailingyachts", "destination": "/fleet", "permanent": true },
    { "source": "/fishingcostadelsol", "destination": "/fleet", "permanent": true },
    { "source": "/group-boat-hire-marbella", "destination": "/fleet", "permanent": true },
    { "source": "/activities", "destination": "/experiences", "permanent": true },
    { "source": "/corporate-and-group-events", "destination": "/experiences/corporate-groups", "permanent": true },
    { "source": "/corporate-events-group-activities-marbella", "destination": "/experiences/corporate-groups", "permanent": true },
    { "source": "/yacht-management-maintenance-puerto-banus", "destination": "/services/yacht-management", "permanent": true },
    { "source": "/cateringmarbella", "destination": "/services/catering", "permanent": true },
    { "source": "/marbella-boat-hire", "destination": "/services/boat-rental-marbella", "permanent": true },
    { "source": "/boat-charter-marbella", "destination": "/services/yacht-charter-marbella", "permanent": true },
    { "source": "/sailboat-rental-marbella", "destination": "/services/sailboat-rental-marbella", "permanent": true },
    { "source": "/catamaran-motor", "destination": "/yachts/motor-catamaran", "permanent": true },
    { "source": "/seawolf-50", "destination": "/yachts/seawolf-50", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data;; img-src 'self' data: https:; connect-src 'self'; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://wa.me; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/control/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
